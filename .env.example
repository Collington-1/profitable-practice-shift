# ==============================================================================
# STRIPE & ENVIRONMENT CONFIGURATION TEMPLATE
# The Profitable Practice Accelerator™
# Replace the placeholder values with your real test/live Stripe credentials.
# DO NOT COMMIT THE ACTUAL .env FILE CONTAINING REAL SECRETS.
# ==============================================================================

# Client-side (Public) Stripe Key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here

# Server-side (Secret) Stripe API Key - NEVER expose to browser
STRIPE_SECRET_KEY=sk_test_placeholder_secret_key_here

# Server-side Webhook Signing Secret (from Stripe Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_here

# Stripe Price IDs (Generated in Stripe Dashboard > Products)
STRIPE_PRICE_ID_PAY_IN_FULL=price_placeholder_pay_in_full
STRIPE_PRICE_ID_TWO_PAYMENTS=price_placeholder_two_payments
STRIPE_PRICE_ID_THREE_PAYMENTS=price_placeholder_three_payments

# Application URLs
APP_URL=https://your-domain.com
STRIPE_SUCCESS_URL=https://your-domain.com/payment-success
STRIPE_CANCEL_URL=https://your-domain.com/#investment
